{
  "name": "tariqahmaad-portfolio",
  "private": true,
  "description": "Static portfolio site. This package.json is dev-only: the site itself ships as plain files with no runtime build.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bump": "node scripts/bump-version.mjs",
    "check:build": "node scripts/build.mjs && git diff --exit-code -- *.min.css *.min.js projects",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint assets/js tests",
    "serve": "python -m http.server 8000",
    "build:resume": "node scripts/build-resume.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}
